{
  "name": "mlo-teachers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx scripts/run-tests.ts",
    "db:apply": "node --env-file=.env.local --import tsx scripts/apply-schema.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "test:db": "node --env-file=.env.local --import tsx --test lib/rate-limit.db.test.ts lib/student-link.db.test.ts lib/recovery.db.test.ts lib/import-base.db.test.ts",
    "db:reset:courses": "node --env-file=.env.local --import tsx scripts/reset-courses-and-groups.ts",
    "seed:admin": "node --env-file=.env.local --import tsx scripts/seed-admin.ts",
    "link:student": "node --env-file=.env.local --import tsx scripts/issue-student-link.ts",
    "import:base": "node --env-file=.env.local --import tsx scripts/import-base.ts",
    "export:release": "node --env-file=.env.local --import tsx scripts/export-release.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
