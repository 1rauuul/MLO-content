# Cadena del pooler de Supabase en modo transacción (puerto 6543).
# La usa la app en runtime.
DATABASE_URL=

# Cadena directa (puerto 5432). Reservada para migraciones y tareas de administración.
DATABASE_URL_DIRECT=

# Primer administrador del panel (npm run seed:admin).
# Si la contraseña lleva #, espacios o comillas, escríbela entre comillas dobles.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DEC-05: si vale "on", el curso base también exige course_access.
# Apagado o ausente permite el base empaquetado en el piloto; nunca autoriza
# cursos adicionales.
MLO_ACCESS_CONTROL=

# Invitaciones por correo (Resend). Sin estas dos variables la invitación se
# crea igual y el panel muestra el enlace para compartirlo a mano.
EMAIL_PROVIDER_API_KEY=
# Remitente verificado en Resend, p. ej. "MLO <no-reply@midominio.com>".
EMAIL_FROM=
